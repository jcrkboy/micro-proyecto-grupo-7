# Copiar a apps/deploy/.env en la VM y ajustar. Este archivo cumple dos roles:
# 1) variables de interpolacion para docker compose
# 2) variables de entorno del contenedor de backend (prefijo SLEEP_API_)

# --- Imagenes publicadas por GitHub Actions desde la rama main ---
API_IMAGE=ghcr.io/jcrkboy/micro-proyecto-grupo-7-api:latest
WEB_IMAGE=ghcr.io/jcrkboy/micro-proyecto-grupo-7-web:latest

# --- Rutas y puertos del host (VM) ---
# Directorio del host que contiene manifest.json y model.txt.
HOST_MODEL_DIR=/opt/sleep-edfx/model
WEB_HOST_PORT=80

# --- Backend: rutas internas del contenedor, siempre absolutas ---
# Las rutas relativas se resuelven contra el directorio de instalacion del
# paquete dentro de la imagen, no contra apps/api. Usar absolutas.
SLEEP_API_MODEL_DIR=/artifacts/model
SLEEP_API_UPLOAD_DIR=/app/storage/uploads
SLEEP_API_MAX_UPLOAD_BYTES=52428800
# El frontend consume la API por el mismo origen via proxy nginx, por lo que
# CORS solo importa si se expone la API directamente a otro dominio.
SLEEP_API_CORS_ORIGINS=["http://localhost"]
